# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller build spec for the Turbo GIF Windows executable."""

from PyInstaller.utils.hooks import collect_submodules

hiddenimports = collect_submodules("pythoncom") + collect_submodules("pywintypes")


a = Analysis(
    ["TurboGifSpammer.py"],
    pathex=[],
    binaries=[],
    datas=[],
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="TurboGifSpammer",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
